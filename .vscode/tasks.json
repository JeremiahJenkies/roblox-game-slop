{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PITCH: Sync latest GitHub changes",
      "type": "shell",
      "command": "git pull --ff-only origin main",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "PITCH: Start Rojo",
      "type": "shell",
      "command": "rojo serve default.project.json",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false }
    },
    {
      "label": "PITCH: Check project files",
      "type": "shell",
      "command": "git status --short && rojo --version",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}